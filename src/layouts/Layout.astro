---
import '@fontsource/anton/latin-400.css';
import '@fontsource-variable/manrope';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import EstimateLink from '../components/EstimateLink.astro';
import { brand, navigation, services, estimateUrl } from '../lib/content';
const { title, description, image = 'hero', home = false } = Astro.props;
const isEstimate = Astro.url.pathname === estimateUrl;
const pageTitle = home ? `${brand.name} | Roofing in ${brand.city}, ${brand.state}` : `${title} | ${brand.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="description" content={description}/>
  <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'}/>
  <meta name="theme-color" content="#181b1b"/>
  <link rel="canonical" href={canonical}/>
  <link rel="icon" href="/roofline.svg" type="image/svg+xml"/>
  <meta property="og:title" content={pageTitle}/>
  <meta property="og:description" content={description}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <meta property="og:image" content={new URL(`/media/${image}-${image === 'hero' ? 1200 : 480}.webp`, Astro.site)}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <title>{pageTitle}</title>
</head>
<body class:list={[home && 'home', isEstimate && 'estimate-page']} id="top">
  <a href="#main" class="skip">Skip to content</a>
  <header class="site-header">
    <div class="nav-bar">
      <a class="brand" href="/" aria-label={brand.name + ' home'}><Icon name="mark" size={35}/><span><strong>{brand.short}</strong><small>{brand.descriptor}</small></span></a>
      <div class="nav-actions">
        {!isEstimate && <EstimateLink class="nav-estimate"/>}
        <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu"><Icon name="menu" size={23}/></button>
      </div>
    </div>
    <nav id="menu" class="menu-panel" aria-label="Main navigation" hidden>
      {navigation.map(([label, href], index) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}><span>0{index + 1}</span>{label}<Icon/></a>)}
      <EstimateLink/>
    </nav>
  </header>
  <main id="main"><slot/></main>
  <footer class="footer">
    <div class="footer-inner wrap">
      <div>
        <a class="brand" href="/"><Icon name="mark" size={40}/><span><strong>{brand.short}</strong><small>{brand.descriptor}</small></span></a>
        <p>Residential roofing and exterior work.<br/>{brand.city}, {brand.state} · {brand.region}</p>
        {brand.contact.email && <a href={`mailto:${brand.contact.email}`}>{brand.contact.email}</a>}
        {brand.contact.phone && <a href={`tel:${brand.contact.phone}`}>{brand.contact.phone}</a>}
      </div>
      <div><p class="eyebrow">Explore</p>{navigation.slice(1).map(([label, href]) => <a href={href}>{label}</a>)}</div>
      <div><p class="eyebrow">Services</p>{services.map(item => <a href={`/services/${item.slug}/`}>{item.name}</a>)}</div>
      <div class="footer-cta"><EstimateLink/><a href="#top">Back to top ↑</a></div>
    </div>
    <div class="footer-bottom wrap"><span>© {new Date().getFullYear()} {brand.name}</span>{brand.demo && <span>Fictional contractor demo · Illustrative imagery</span>}</div>
    <div class="footer-word" aria-hidden="true">{brand.short}</div>
  </footer>
  <script>
    const menu = document.querySelector<HTMLElement>('#menu')!;
    const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
    function setMenu(open: boolean, restore = false) {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (restore) toggle.focus();
    }
    toggle.addEventListener('click', () => setMenu(menu.hidden));
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !menu.hidden) setMenu(false, true);
    });
    document.addEventListener('click', event => {
      if (!menu.hidden && event.target instanceof Element && !event.target.closest('.site-header')) setMenu(false);
    });
  </script>
</body>
</html>
