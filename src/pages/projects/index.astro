---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Media from '../../components/Media.astro';
import Icon from '../../components/Icon.astro';
import Closing from '../../components/Closing.astro';
import { projects } from '../../lib/content';
---
<Layout title="Projects" description="Explore illustrative roofing, siding, and metal roof project concepts.">
  <PageIntro label="02 / Selected projects" title="Exterior project concepts" description="See how shingle color, standing seams, and siding profiles change the character of a home. These examples and their imagery are illustrative."/>
  <section class="wrap sub-card-grid section-space" aria-label="All projects">
    {projects.map(item => <article class="sub-card"><a href={`/projects/${item.slug}/`}><div class="sub-card-image"><Media name={item.image} sizes="(min-width: 768px) 43vw, 92vw"/><span class="stamp">Illustrative project</span></div><span class="eyebrow">{item.type}</span><h2>{item.name}</h2><p>{item.intro}</p><span class="text-link">View project <Icon size={16}/></span></a></article>)}
  </section>
  <Closing/>
</Layout>
